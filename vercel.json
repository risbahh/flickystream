{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/(.+\\.html)", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/detail", "dest": "/detail.html" },
    { "src": "/watch", "dest": "/watch.html" },
    { "src": "/search", "dest": "/search.html" },
    { "src": "/browse", "dest": "/browse.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
